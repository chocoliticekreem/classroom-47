# Copy to .env (gitignored at repo root) and fill in.
NVIDIA_API_KEY=
# Change if the organisers give you a Cosmos endpoint (NIM / vLLM) in the VAST/CoreWeave environment.
COSMOS_BASE_URL=https://integrate.api.nvidia.com/v1
COSMOS_MODEL=nvidia/cosmos3-nano-reasoner

WANDB_API_KEY=
WANDB_BASE_URL=https://api.inference.wandb.ai/v1
WANDB_MODEL=Qwen/Qwen3.8-27B
WANDB_FAST_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B
