# Copy to services/vision/.env and fill in. .env is gitignored: never commit real keys (the repo is public).

# W&B Inference (CoreWeave), OpenAI-compatible. Key: https://wandb.ai/authorize
WANDB_API_KEY=
# Not WANDB_BASE_URL: the W&B SDK reads that name for its own server and breaks.
WANDB_INFERENCE_URL=https://api.inference.wandb.ai/v1
WANDB_VL_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B
# Your W&B entity (team or username) and project, for Weave traces.
WANDB_TEAM=
WANDB_PROJECT=classroom-47

# Cosmos on the event's CoreWeave GPUs (vast-builders-challenge .cursor/skills/gpu/README.md).
# The token is GPU_BEARER_TOKEN in /config/<team>.config on the lab VM.
COSMOS3_REASON_URL=http://166.19.38.112:8001
COSMOS_EMBED1_URL=http://166.19.38.112:8003
GPU_BEARER_TOKEN=
