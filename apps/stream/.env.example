# Copy to .env.local and fill in. Names only here; never commit values.

# W&B Inference (OpenAI-compatible): writes the persona chat. Unset = local template chat.
WANDB_API_KEY=
# Weave traces (project `team/project` on trace.wandb.ai). Unset = no traces.
WANDB_TEAM=
WANDB_PROJECT=
# Optional model overrides
WANDB_MODEL=
WANDB_VISION_MODEL=
WANDB_BASE_URL=
